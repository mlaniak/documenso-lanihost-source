# Store the real values in /opt/documenso/monitor.env with mode 600.
# Do not commit the production monitor.env file.
DOCUMENSO_MONITOR_APP_URL=https://documents.example.com
DOCUMENSO_MONITOR_ALERT_TO=operations@example.com
DOCUMENSO_BACKUP_S3_BUCKET=example-private-backup-bucket
DOCUMENSO_BACKUP_S3_PREFIX=databases
DOCUMENSO_BACKUP_S3_PROFILE=backup
DOCUMENSO_BACKUP_S3_REGION=us-east-2
DOCUMENSO_BACKUP_DIRECTORY=/opt/backups/databases
